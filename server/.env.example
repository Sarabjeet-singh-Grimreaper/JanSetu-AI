# ===================================================================
# JanSetu AI (जनसेतु) - Server Environment Configuration
# Digital Public Good for Citizen Feedback & Infrastructure Intelligence
# ===================================================================

# Server Port (default: 5000)
PORT=5000

# Google AI Studio API Key (Optional)
# Get your free API key at: https://aistudio.google.com/
# Note: If left blank, JanSetu AI automatically runs its built-in
# intelligent offline engine for smooth presentations and offline demos.
GEMINI_API_KEY=

# Gemini Model Selection
# Options: gemini-2.5-flash (recommended), gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Node Environment (development | production)
NODE_ENV=development
